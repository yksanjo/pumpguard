# PumpGuard — all optional, everything works out of the box with defaults

# Data sources (optional — PumpGuard works with just the WebSocket)
HELIUS_API_KEY=
BITQUERY_API_KEY=

# Alerts (optional — without these, alerts go to terminal only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
DATABASE_PATH=~/.pumpguard/pumpguard.sqlite
LOG_LEVEL=INFO
DRY_RUN=1                  # 1 = print alerts only; 0 = send notifications
